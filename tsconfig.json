{
  "compilerOptions": {
    "strict": false,
    "allowJs": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "target": "es2022",
    "sourceMap": true,
    "outDir": "./.tmp/build/",
    "moduleResolution": "node",
    "declaration": true,
    "skipLibCheck": true,
    "lib": ["es2022", "dom"],
    "typeRoots": ["node_modules/@types"],
    "types": []
  },
  "files": [
    "./src/visual.ts",
    "./src/settings.ts",
    "./src/model.ts",
    "./src/render.ts",
    "./src/format.ts",
    "./src/scale.ts"
  ]
}
