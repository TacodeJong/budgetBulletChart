{
  "supportsKeyboardFocus": true,
  "dataRoles": [
    {
      "displayName": "Period",
      "name": "period",
      "kind": "Grouping",
      "description": "One bar group per period. Add a date hierarchy or several fields (year, quarter, month) to drill down; expand all down shows the levels as a nested axis."
    },
    {
      "displayName": "Group",
      "name": "group",
      "kind": "Grouping",
      "description": "One panel per value. A field parameter works here. Leave empty for a single panel.",
      "preferredTypes": [{ "text": true }]
    },
    {
      "displayName": "Component",
      "name": "component",
      "kind": "Grouping",
      "description": "Revenue or cost. Values that start with one of the revenue values in Grouping count as revenue; everything else counts as cost.",
      "preferredTypes": [{ "text": true }]
    },
    {
      "displayName": "Legend",
      "name": "legend",
      "kind": "Grouping",
      "description": "Optional. Splits every budget and actual bar into one bar per value and colors the budget bars by value. Set the colors under Colors.",
      "preferredTypes": [{ "text": true }]
    },
    {
      "displayName": "Budget",
      "name": "budget",
      "kind": "Measure",
      "description": "One or more budget measures. Fields pair by order with Actual YTD: the first budget with the first actual, and so on. Field names (or Rename for this visual) are used as pair names.",
      "preferredTypes": [{ "numeric": true }]
    },
    {
      "displayName": "Actual YTD",
      "name": "actual",
      "kind": "Measure",
      "description": "One or more actual measures. Fields pair by order with Budget: the first actual with the first budget, and so on.",
      "preferredTypes": [{ "numeric": true }]
    },
    {
      "displayName": "Target",
      "name": "target",
      "kind": "Measure",
      "description": "Optional. One or more target measures. Fields pair by order with Budget and Actual YTD: the first target belongs to the first pair, and so on.",
      "preferredTypes": [{ "numeric": true }]
    },
    {
      "displayName": "Tooltips",
      "name": "tooltips",
      "kind": "Measure",
      "description": "Extra fields shown in the tooltip."
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "period": { "max": 6 },
          "group": { "max": 1 },
          "component": { "max": 1 },
          "legend": { "max": 1 },
          "budget": { "max": 10 },
          "actual": { "max": 10 },
          "target": { "max": 10 },
          "tooltips": { "max": 10 }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            { "for": { "in": "period" } },
            { "for": { "in": "group" } },
            { "for": { "in": "component" } },
            { "for": { "in": "legend" } }
          ],
          "dataReductionAlgorithm": { "top": { "count": 10000 } }
        },
        "values": {
          "select": [
            { "for": { "in": "budget" } },
            { "for": { "in": "actual" } },
            { "for": { "in": "target" } },
            { "for": { "in": "tooltips" } }
          ]
        }
      }
    }
  ],
